# Copy to .env. Dry run is on: the steps read the wiki but record each write in the
# job's would-write/ instead of making it. Set DRY_RUN=0 only to write for real.
DRY_RUN=1

# Your own key works (the one the Outline MCP uses): a dry run never writes with it.
OUTLINE_URL=https://wiki.quantum-aspen.net
OUTLINE_API_KEY=
MEETINGS_COLLECTION_ID=

# The agent step. Hermes uses Lumen.
LUMEN_BASE_URL=
LUMEN_API_KEY=

# Small and quick for trying things; production uses large-v3-turbo.
WHISPER_MODEL=base
